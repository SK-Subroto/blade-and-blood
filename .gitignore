# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp

# Firebase deploy cache and logs (.firebaserc and firebase.json are kept)
.firebase/
firebase-debug.log*
firebase-debug.*.log*

# GitLab Pages output (built by CI)
public/

# Node, in case tooling is added later
node_modules/

# Secrets: never commit these (service-account keys, private keys, env files)
.env
.env.*
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.pem
*.key
*.p12

# Logs and temporary files
*.log
*.tmp
